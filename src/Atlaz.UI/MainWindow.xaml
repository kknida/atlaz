<Window x:Class="Atlaz.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Atlaz.UI.ViewModels"
        mc:Ignorable="d"
        Title="Atlaz" 
        Height="700" Width="1060" 
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Nav Button Style -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Panel Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Default TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="IsEnabled" Value="True"/>
        </Style>

        <!-- Default CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR NAVIGATION -->
        <Border Grid.Column="0" Background="#1E293B">
            <DockPanel LastChildFill="True">
                <!-- App Title / Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,30">
                    <TextBlock Text="ATLAZ" FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Desktop Automation Engine" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Footer Status -->
                <Border DockPanel.Dock="Bottom" Background="#0F172A" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Mode Sistem:" FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock Text="Tahap 2 (Otomasi SAP Aktif)" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <!-- Nav Menu Items -->
                <StackPanel Margin="0,10,0,0">
                    <Button Content="📊  Dashboard" Style="{StaticResource NavBtnStyle}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Dashboard"/>
                    <Button Content="⏰  Pengaturan Jadwal" Style="{StaticResource NavBtnStyle}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Scheduler"/>
                    <Button Content="⚙️  Konfigurasi Sistem" Style="{StaticResource NavBtnStyle}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="Settings"/>
                    <Button Content="📜  Riwayat &amp; Log" Style="{StaticResource NavBtnStyle}" 
                            Command="{Binding SwitchViewCommand}" CommandParameter="History"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="24">

            <!-- 1. DASHBOARD VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock Text="Dashboard Kontrol Atlaz" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                    <!-- Action Banner: UJI COBA RUN MANUAL -->
                    <Border Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Uji Coba Eksekusi Otomasi (Manual Run)" FontSize="16" FontWeight="Bold" Foreground="#0369A1"/>
                                <TextBlock Text="Tekan tombol untuk menguji alur otomasi SAP ZFM001 secara langsung dari parameter yang telah Anda konfigurasi." 
                                           FontSize="12" Foreground="#0284C7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔍  Cek Kesiapan SAP" 
                                        Command="{Binding DiagnoseSapCommand}"
                                        Background="#E2E8F0" Foreground="#0F172A" 
                                        FontSize="13" FontWeight="SemiBold" 
                                        Padding="14,12" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="▶  RUN MANUAL SEKARANG" 
                                        Command="{Binding RunManualSyncCommand}"
                                        Background="#0284C7" Foreground="#FFFFFF" 
                                        FontSize="14" FontWeight="Bold" 
                                        Padding="20,12" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metric Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="STATUS SISTEM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="JADWAL BERIKUTNYA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding NextScheduleTime}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="EKSEKUSI TERAKHIR" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding LastRunTime}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 4-Phase Step Progress Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Indikator Tahap Otomasi" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding PhaseStatusText}" FontSize="13" Foreground="#475569" Margin="0,4,0,14"/>

                            <ProgressBar Value="{Binding ProgressValue}" Height="12" Maximum="100" Margin="0,0,0,16" Background="#E2E8F0" Foreground="#0284C7"/>

                            <UniformGrid Columns="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tahap 1" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Interface WPF" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tahap 2" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Otomasi SAP" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tahap 3" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Validasi CSV" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tahap 4" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sync Data" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. SCHEDULER VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Scheduler">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock Text="Pengaturan Jadwal Otomasi" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <CheckBox Content="Aktifkan Penjadwalan Otomatis" 
                                      IsChecked="{Binding Schedule.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      FontWeight="SemiBold" FontSize="14" Margin="0,0,0,18"/>

                            <!-- Pilihan Mode Jadwal -->
                            <TextBlock Text="Mode Penjadwalan Eksekusi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <RadioButton Content="📅  Jadwal Tiap Jam / Hari Tertentu" 
                                             IsChecked="{Binding Schedule.IsHourly, Mode=OneWay}" 
                                             Command="{Binding SetScheduleIntervalTypeCommand}" 
                                             CommandParameter="Hourly"
                                             FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,24,0" Cursor="Hand"/>
                                <RadioButton Content="⚡  Update Tiap Berapa Menit (Uji Coba Cepat)" 
                                             IsChecked="{Binding Schedule.IsEveryNMinutes, Mode=OneWay}" 
                                             Command="{Binding SetScheduleIntervalTypeCommand}" 
                                             CommandParameter="EveryNMinutes"
                                             FontSize="13" FontWeight="SemiBold" Foreground="#0284C7" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Sub-Panel 1: Mode Interval Tiap N Menit (Untuk Uji Coba Cepat) -->
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Schedule.IsEveryNMinutes}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Interval Pengulangan Eksekusi (Menit):" FontSize="13" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding Schedule.IntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Menit (Contoh: 1, 2, 5, 10, atau 30 menit)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="* Bot akan menjalankan proses sinkronisasi secara berulang sesuai jumlah menit yang Anda masukkan." 
                                               FontSize="11" Foreground="#0284C7" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Sub-Panel 2: Mode Tiap Jam / Harian dengan Pilihan Hari -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Schedule.IsHourly}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Waktu Eksekusi Harian (Format HH:mm):" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Schedule.ScheduledTimeString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="180" HorizontalAlignment="Left" Margin="0,0,0,18"/>

                                <TextBlock Text="Pilihan Hari Eksekusi:" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,24">
                                    <CheckBox Content="Senin" IsChecked="{Binding Schedule.RunOnMonday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Selasa" IsChecked="{Binding Schedule.RunOnTuesday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Rabu" IsChecked="{Binding Schedule.RunOnWednesday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Kamis" IsChecked="{Binding Schedule.RunOnThursday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Jumat" IsChecked="{Binding Schedule.RunOnFriday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Sabtu" IsChecked="{Binding Schedule.RunOnSaturday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                    <CheckBox Content="Minggu" IsChecked="{Binding Schedule.RunOnSunday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,10"/>
                                </WrapPanel>
                            </StackPanel>

                            <Button Content="💾  Simpan Jadwal" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    Background="#059669" Foreground="#FFFFFF" 
                                    FontWeight="Bold" FontSize="13" 
                                    Padding="18,10" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>

                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. SETTINGS VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock Text="Konfigurasi Sistem" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
                    
                    <!-- SAP Settings -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Parameter SAP GUI (ZFM001)" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,14"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Nama Koneksi / Description di SAP Logon:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.SystemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contoh: INTERNET PROD - AEP"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Client (Contoh: 100):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.Client, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Username SAP:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Password SAP:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.EncryptedPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Kode Transaksi:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.TransactionCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="FM Area:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.FmArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="Budget Category:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.BudgetCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                                    <TextBlock Text="Version:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Fiscal Year (Tahun):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.FiscalYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="From Period:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.FromPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="To Period:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.ToPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Funds Center (From):" FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.FundsCenterFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contoh: A022020000"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Funds Center (To):" FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.FundsCenterTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Kosongkan jika hanya 1 nilai"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                    <TextBlock Text="Commitment Item (Opsional):" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SapConfig.CommitmentItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Remote Transfer Settings -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Pengaturan Sinkronisasi Data ke Server Web Darsana" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <TextBlock Text="Pilih jalur transfer. Jalur SFTP (Port 22 SSH) adalah solusi utama yang kebal blokir Imunify360 WAF karena tidak melalui layer web HTTP." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="Pilihan Jalur Pengiriman Data:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton Content="🚀  SFTP cPanel Port 22 (Bebas Imunify360 WAF)" 
                                             IsChecked="{Binding DarsanaConfig.IsSftp, Mode=OneWay}"
                                             Command="{Binding SetTransferProtocolCommand}" 
                                             CommandParameter="SFTP"
                                             FontSize="13" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,24,0" Cursor="Hand"/>
                                <RadioButton Content="🌐  REST API Web (/api/sap/import)" 
                                             IsChecked="{Binding DarsanaConfig.IsApi, Mode=OneWay}"
                                             Command="{Binding SetTransferProtocolCommand}" 
                                             CommandParameter="API_GZIP"
                                             FontSize="13" FontWeight="SemiBold" Foreground="#64748B" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Sub-Panel: Pengaturan SFTP cPanel (Aktif Saat SFTP Dipilih) -->
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DarsanaConfig.IsSftp}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Host Server cPanel / SFTP:" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contoh: darsana.airnavsub.id atau IP Server cPanel"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Port SFTP (SSH):" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port standar SSH adalah 22"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Username cPanel / SFTP:" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Username akun cPanel atau FTP Anda"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Password cPanel / SFTP:" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.EncryptedPasswordOrToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Password akun cPanel atau FTP Anda"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote Staging Path (Folder Tujuan di Server):" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DarsanaConfig.RemoteStagingPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contoh: storage/app/sap/incoming"/>
                            </StackPanel>

                            <!-- Sub-Panel: Pengaturan REST API (Aktif Saat API Dipilih) -->
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DarsanaConfig.IsApi}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="URL Web Darsana (DASHBOARD_URL):" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.DashboardUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Contoh: https://darsana.airnavsub.id"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="API Bearer Token (BOT_TOKEN):" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DarsanaConfig.ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="💾  Simpan Konfigurasi" 
                                        Command="{Binding SaveSettingsCommand}" 
                                        Background="#0284C7" Foreground="#FFFFFF" 
                                        FontWeight="Bold" FontSize="13" 
                                        Padding="18,10" Margin="0,0,12,0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="🧪  Tes Koneksi (SFTP / API)" 
                                        Command="{Binding TestDarsanaConnectionCommand}" 
                                        Background="#0F766E" Foreground="#FFFFFF" 
                                        FontWeight="SemiBold" FontSize="13" 
                                        Padding="16,10" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. HISTORY VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="History">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock Text="Riwayat Eksekusi &amp; Log" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardPanel}">
                        <DataGrid ItemsSource="{Binding ExecutionHistory}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Waktu" Binding="{Binding Timestamp, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="140"/>
                                <DataGridTextColumn Header="Tahap / Tipe" Binding="{Binding Step}" Width="150"/>
                                <DataGridTextColumn Header="File CSV" Binding="{Binding FileName}" Width="190"/>
                                <DataGridTextColumn Header="Baris Data" Binding="{Binding RecordCount}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Keterangan" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
